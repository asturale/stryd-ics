# Required
STRYD_EMAIL=you@example.com
STRYD_PASSWORD=your-stryd-password

# Recommended: keeps the feed URL secret (served at /<ICS_TOKEN>.ics).
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(20))"
# If unset, the feed is served at the guessable /calendar.ics instead.
ICS_TOKEN=

# Optional
# TZ_NAME=Europe/Amsterdam
# CALNAME=Stryd workouts
# REFRESH_SECONDS=21600
# LOOKAHEAD_DAYS=150
# PORT=8080
# Add a reminder (VALARM) at this local hour (0-23) on the workout day.
# Leave unset for no reminder. Many calendar clients ignore embedded
# reminders on subscribed/read-only feeds and use their own default instead.
# REMINDER_HOUR=7
